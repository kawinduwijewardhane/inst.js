{
  "name": "@instjs/core",
  "version": "1.0.2",
  "description": "Core types, configuration, and Web-standard response helpers for Inst.js.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "!dist/**/*.test.*"],
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./adapter": {"types": "./dist/adapter.d.ts", "import": "./dist/adapter.js"},
    "./units": {"types": "./dist/units.d.ts", "import": "./dist/units.js"}
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "repository": {"type": "git", "url": "git+https://github.com/kawinduwijewardhane/inst.js.git", "directory": "packages/core"},
  "publishConfig": {"access": "public"},
  "engines": {"node": ">=22.0.0"}
}
