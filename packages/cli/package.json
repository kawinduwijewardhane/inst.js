{
  "name": "@instjs/cli",
  "version": "1.0.1",
  "description": "Command-line development, build, and project scaffolding for Inst.js.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "bin": {
    "inst": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-cli-brand-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@instjs/adapter-node": "workspace:*",
    "@instjs/compiler": "workspace:*",
    "@instjs/core": "workspace:*",
    "@instjs/runtime": "workspace:*",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawinduwijewardhane/inst.js.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
